# Aurora Environment Configuration
# Copy this file to .env and fill in your credentials

# ── Data Provider Keys ────────────────────────────────────────────────────────
# Alpha Vantage is the primary equity data source (TIME_SERIES_DAILY_ADJUSTED).
# Get a free key at: https://www.alphavantage.co/support/#api-key
# Free tier: 25 requests/day.  Set ALPHA_VANTAGE_PREMIUM=true for paid plans.
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here
ALPHA_VANTAGE_PREMIUM=false
POLYGON_API_KEY=your_polygon_api_key_here
FRED_API_KEY=your_fred_api_key_here
NEWS_API_KEY=your_newsapi_key_here

# ── Reddit API (for sentiment) ─────────────────────────────────────────────────
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=aurora_sentiment_bot/1.0

# ── Twitter/X API ──────────────────────────────────────────────────────────────
TWITTER_BEARER_TOKEN=your_twitter_bearer_token

# ── Bloomberg (optional hook) ──────────────────────────────────────────────────
BLOOMBERG_HOST=localhost
BLOOMBERG_PORT=8194

# ── MLflow Tracking ────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=sqlite:///outputs/mlflow.db
MLFLOW_EXPERIMENT_NAME=aurora_research

# ── Weights & Biases ───────────────────────────────────────────────────────────
WANDB_API_KEY=your_wandb_key
WANDB_PROJECT=aurora-financial-intelligence
WANDB_ENTITY=your_wandb_entity

# ── Application Config ─────────────────────────────────────────────────────────
AURORA_ENV=development
AURORA_LOG_LEVEL=INFO
AURORA_DATA_DIR=./outputs/data
AURORA_CACHE_DIR=./outputs/cache
AURORA_MODEL_DIR=./outputs/models
AURORA_RESULTS_DIR=./outputs/results

# ── API Settings ───────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_SECRET_KEY=change_this_to_a_random_secret_key

# ── GPU Settings ───────────────────────────────────────────────────────────────
CUDA_VISIBLE_DEVICES=0
TORCH_NUM_THREADS=8
